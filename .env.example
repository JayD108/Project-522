# Copy to .env for local overrides (.env is git-ignored). No secrets are needed so far.
# Port the local server listens on (Chrome on ChromeOS reaches Crostini at http://localhost:<PORT>)
PORT=8080
# 0.0.0.0 = reachable from other devices on the Wi-Fi (after ChromeOS port forwarding); 127.0.0.1 = this machine only
HOST=0.0.0.0
# Where the server keeps its SQLite file (default: ./data). systemd unit uses ~/.local/share/jharokha
# JHK_DATA=./data
