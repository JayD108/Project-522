<?xml version="1.0" encoding="utf-8"?>
<!-- The internet link is https (Cloudflare). On the room's Wi-Fi the laptop only speaks plain http on a private
     address (e.g. http://192.168.1.23:8080), the same as the phone web page, so cleartext has to be allowed. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
